# docker compose / 各サービス共通で参照される変数
# `cp .env.example .env` してから利用

# --- PostgreSQL ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# --- FastAPI ---
API_PORT=8000
# compose 内では db ホスト、ローカル直接実行時は localhost に変える
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
CORS_ORIGINS=http://localhost:3000

# --- Next.js ---
WEB_PORT=3000
# 空なら apps/web は内蔵モックBE (src/lib/mock) で動作する。
# 実BEに接続するときだけ URL を設定する
BE_URL=

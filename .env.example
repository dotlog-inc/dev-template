# docker compose / 各サービス共通で参照される変数
# `cp .env.example .env` してから利用

# --- PostgreSQL ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# --- FastAPI ---
API_PORT=8080
# compose 内の DATABASE_URL は POSTGRES_* から docker-compose.yml が組み立てる。
# ホスト直接実行 (mise run //apps/api:dev) の設定は apps/api/.env 側にある。
CORS_ORIGINS=http://localhost:3000

# --- Next.js ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# docker compose / 各サービス共通で参照される変数
# `cp .env.example .env` してから利用

# --- PostgreSQL ---
# superuser。初期化とバックアップ以外では使わない
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# ロール名はこの DB 名から導く（<POSTGRES_DB>_app / <POSTGRES_DB>_migrator）。
# 変えたときは apps/api/.env の接続 URL も揃えること
POSTGRES_DB=devtemplate
POSTGRES_PORT=5432

# アプリ用ロールと所有者ロールのパスワード（ローカルのみ。本番は秘密管理側に置く）
APP_PASSWORD=devtemplate_app
MIGRATOR_PASSWORD=devtemplate_migrator

# --- FastAPI ---
API_PORT=8080
# compose 内の DATABASE_URL は POSTGRES_DB と APP_PASSWORD から docker-compose.yml が
# 組み立てる（アプリ用ロールだけ。所有者の資格情報は api へ渡さない）。
# ホスト直接実行 (mise run //apps/api:dev) の設定は apps/api/.env 側にある。
CORS_ORIGINS=http://localhost:3000

# --- Next.js ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

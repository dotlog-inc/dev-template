# FastAPI をローカル直接実行 (`mise run //apps/api:dev`) する場合の設定
# compose 経由のときはルート .env が使われる

# アプリ用。DML だけを持ち、DDL は実行できないロール
DATABASE_URL=postgresql+psycopg://devtemplate_app:devtemplate_app@localhost:5432/devtemplate
# マイグレーション用。テーブル所有者となり DDL を実行するロール。
# alembic（mise run //apps/api:db:migrate）だけがこれを読む
MIGRATION_DATABASE_URL=postgresql+psycopg://devtemplate_migrator:devtemplate_migrator@localhost:5432/devtemplate
CORS_ORIGINS=http://localhost:3000

# この環境が繋いでよい DB のホスト（#30。カンマ区切り）。
# **空なら localhost / 127.0.0.1 / db だけ。** 本番はデプロイ先の env で自分の DB ホストを
# 名乗る（書き忘れると起動しない。打ち消しフラグにしていないのはそのため）
DB_ALLOWED_HOSTS=

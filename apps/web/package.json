{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "stylelint": "stylelint 'src/**/*.css'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "knip": "knip --cache",
    "format": "prettier --write .",
    "format:check": "prettier --check . --cache --cache-strategy content"
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10",
    "jsdom": "^30",
    "knip": "^6",
    "prettier": "^3",
    "stylelint": "^17",
    "typescript": "^5",
    "vitest": "^5"
  }
}
